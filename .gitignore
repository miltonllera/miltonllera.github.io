cv/*.aux
cv/*.log
cv/*.out
cv/*.toc
cv/*.fls
cv/*.fdb_latexmk
cv/*.synctex.gz

# Allow public/cv.pdf even if global gitignore ignores *.pdf
!public/cv.pdf

