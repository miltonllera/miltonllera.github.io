---
import { siteConfig } from '../data/cv';
---

<footer class="site-footer no-print">
  <div class="container footer-inner">
    <div class="footer-links">
      {siteConfig.socials.map((social) => (
        <a href={social.url} target="_blank" rel="noopener noreferrer" class="footer-link">
          {social.name}
        </a>
      ))}
      {siteConfig.emails.map((email) => (
        <a href={`mailto:${email.address}`} class="footer-link">
          {email.address}
        </a>
      ))}
    </div>
    
    <div class="footer-bottom">
      <p class="copyright">
        &copy; {new Date().getFullYear()} {siteConfig.name}. All rights reserved.
      </p>
      <p class="built-with">
        Designed for academia. Hosted on <a href="https://pages.github.com/" target="_blank" rel="noopener noreferrer">GitHub Pages</a>.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background-color: var(--bg-surface);
    margin-top: 5rem;
    padding: 3rem 0 2.5rem;
    color: var(--text-muted);
    font-size: 0.9rem;
    transition: background-color 0.25s ease, border-color 0.25s ease;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    align-items: center;
  }

  .footer-link {
    color: var(--text-muted);
    font-weight: 500;
    transition: color 0.18s ease;
  }

  .footer-link:hover {
    color: var(--accent);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.85rem;
    color: var(--text-dim);
  }

  .footer-bottom p {
    margin: 0;
    color: var(--text-dim);
  }

  .footer-bottom a {
    color: var(--text-muted);
  }

  .footer-bottom a:hover {
    color: var(--accent);
  }
</style>
