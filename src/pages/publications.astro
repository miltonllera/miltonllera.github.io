---
import Layout from '../layouts/Layout.astro';
import {
  siteConfig,
  journalArticles,
  conferenceProceedings,
  preprintsAndWorkshops,
  invitedTalks,
  contributedPresentations,
  type PublicationItem,
  type PresentationItem
} from '../data/cv';

function formatAuthors(authorsStr: string) {
  // Highlight Milton's name variants cleanly in bold without nested tags
  return authorsStr.replace(/Montero, M\.(?: L\.)?/g, '<strong>$&</strong>');
}

interface PublicationSection {
  id: string;
  title: string;
  shortLabel: string;
  items: PublicationItem[];
}

interface PresentationSection {
  id: string;
  title: string;
  shortLabel: string;
  items: PresentationItem[];
}

const publicationSections: PublicationSection[] = [
  { id: 'journals', title: 'Journal Articles', shortLabel: 'Journals', items: journalArticles },
  { id: 'conferences', title: 'Conference Proceedings', shortLabel: 'Conferences', items: conferenceProceedings },
  { id: 'preprints', title: 'Preprints & Workshop Papers', shortLabel: 'Preprints', items: preprintsAndWorkshops }
];

const presentationSections: PresentationSection[] = [
  { id: 'talks', title: 'Invited Talks & Panel Discussions', shortLabel: 'Invited Talks', items: invitedTalks },
  { id: 'posters', title: 'Selected Contributed Presentations & Posters', shortLabel: 'Posters & Presentations', items: contributedPresentations }
];

const allSections = [...publicationSections, ...presentationSections];
---

<Layout title={`Publications & Talks | ${siteConfig.name}`}>
  <div class="container publications-page">
    
    <!-- Page Header -->
    <div class="page-header">
      <div class="header-content">
        <h1>Publications & Talks</h1>
        <p class="header-desc">
          Peer-reviewed journal articles, conference proceedings, preprints, and invited presentations.
        </p>
      </div>

      <!-- Quick Section Jump Navigation -->
      <nav class="quick-nav" aria-label="Sections navigation">
        <span class="quick-nav-label">Jump to:</span>
        {allSections.map((sec, idx) => (
          <span>
            <a href={`#${sec.id}`} class="quick-link">
              {sec.shortLabel} ({sec.items.length})
            </a>
            {idx < allSections.length - 1 ? <span class="sep">&bull;</span> : null}
          </span>
        ))}
      </nav>
    </div>

    <!-- Publications Sections (Journals, Conferences, Preprints) -->
    {publicationSections.map((sec) => (
      <section id={sec.id} class="pub-section">
        <h2 class="section-title">{sec.title}</h2>
        <ol class="pub-list">
          {sec.items.map((pub) => (
            <li class="pub-item">
              <div class="pub-citation">
                <span set:html={formatAuthors(pub.authors)} /> ({pub.year}).{' '}
                <strong class="pub-title">{pub.title}</strong>.{' '}
                <em class="pub-venue">{pub.venue}</em>.
                <span class="pub-links">
                  {pub.links.map((link) => (
                    <a href={link.url} target="_blank" rel="noopener noreferrer" class="link-badge">
                      {link.label}
                    </a>
                  ))}
                </span>
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))}

    <!-- Presentations Sections (Invited Talks, Contributed Posters) -->
    {presentationSections.map((sec) => (
      <section id={sec.id} class="pub-section">
        <h2 class="section-title">{sec.title}</h2>
        <ul class="talk-list">
          {sec.items.map((item) => (
            <li class="talk-item">
              <div class="talk-header">
                <strong class="talk-title">{item.title}</strong>
              </div>
              <div class="talk-meta">
                <span class="talk-event">{item.event}</span> &bull; 
                <span class="talk-year">{item.year}</span>
                <span class="pub-links">
                  {item.links.map((link) => (
                    <a href={link.url} target="_blank" rel="noopener noreferrer" class="link-badge">
                      {link.label}
                    </a>
                  ))}
                </span>
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}

  </div>
</Layout>

<style>
  .publications-page {
    padding-top: 3rem;
  }

  .page-header {
    margin-bottom: 3.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .header-content h1 {
    font-size: 2.15rem;
    letter-spacing: -0.02em;
    margin-bottom: 0.35rem;
  }

  .header-desc {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  /* Quick Navigation */
  .quick-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.88rem;
  }

  .quick-nav-label {
    font-weight: 600;
    color: var(--text-dim);
    margin-right: 0.2rem;
  }

  .quick-link {
    color: var(--accent);
    text-decoration: none;
  }

  .quick-link:hover {
    text-decoration: underline;
  }

  .sep {
    color: var(--text-dim);
    margin: 0 0.2rem;
  }

  /* Section styling */
  .pub-section {
    margin-bottom: 4rem;
    scroll-margin-top: 5rem;
  }

  .pub-list {
    padding-left: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .pub-item {
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--text-main);
  }

  .pub-citation {
    margin: 0;
  }

  .pub-title {
    color: var(--text-main);
  }

  .pub-venue {
    color: var(--text-muted);
  }

  .pub-links {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-left: 0.35rem;
  }

  /* Talks & Presentations List */
  .talk-list {
    list-style: disc;
    padding-left: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .talk-item {
    font-size: 0.98rem;
    line-height: 1.65;
  }

  .talk-header {
    margin-bottom: 0.2rem;
  }

  .talk-title {
    color: var(--text-main);
  }

  .talk-meta {
    font-size: 0.92rem;
    color: var(--text-muted);
  }
</style>
